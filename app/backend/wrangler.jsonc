{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notify",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "kv_namespaces": [
    {
      "binding": "DEVICES",
      "id": "placeholder-devices-kv-id"
    }
  ],
  "vars": {
    "CORS": "false"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
