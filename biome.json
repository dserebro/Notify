{
    "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
    "vcs": {
        "enabled": false,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**/*.ts",
            "**/*.tsx",
            "**/*.js",
            "**/*.jsx",
            "**/*.json",
            "!**/node_modules/**",
            "!**/dist/**",
            "!**/build/**",
            "!**/coverage/**",
            "!**/data/**",
            "!**/*.min.js",
            "!app/backend/**",
            "!app/frontend/build/**",
            "!app/frontend/node_modules/**",
            "!app/server/test/fixtures/*.json",
            "!**/package-lock.json",
            "!**/playwright-report/**"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all",
            "arrowParentheses": "always"
        }
    },
    "json": {
        "formatter": {
            "indentWidth": 4,
            "trailingCommas": "none"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "style": {
                "noNonNullAssertion": "off",
                "useImportType": "warn"
            },
            "suspicious": {
                "noExplicitAny": "warn"
            }
        }
    }
}
