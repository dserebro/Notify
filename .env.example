# Notify configuration. Copy to `.env` and fill in before running:
#     node --env-file-if-exists=.env app/server/dist/index.js run

# VAPID subscription contact (RFC 8292). REQUIRED.
SUB=mailto:you@example.com

# Bearer token required to call POST /api/notify. Highly recommended.
# Any long random value; rotate when leaked.
SENDKEY=change-me

# Optional bearer token required to call POST /api/device.
# Leave empty to allow public registration.
LOGINKEY=

# Optional base64(JWK) VAPID private key. If unset, Notify generates
# one on first start and writes it to <dataDir>/vapid.json. Set this
# only to import a key from a previous instance (so existing browser
# subscriptions keep working).
VAPID_KEY=

# SQLite database file. Parent directories are created on demand.
DATABASE_PATH=./data/notify.db

# Serve the built PWA from this directory.
FRONTEND=./app/frontend/dist

# Network listen address.
HOST=0.0.0.0
PORT=8787

# Enable CORS when the PWA is served on a different origin.
CORS=false

# Trust X-Forwarded-* headers (set true behind a reverse proxy).
TRUST_PROXY=false

# Log verbosity: trace|debug|info|warn|error
LOG_LEVEL=info
